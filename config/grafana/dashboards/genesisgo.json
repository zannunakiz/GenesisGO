{
  "id": null,
  "uid": "genesisgo",
  "title": "GenesisGo",
  "timezone": "UTC",
  "schemaVersion": 30,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API requests/sec",
      "datasource": { "uid": "PROM", "type": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(genesisgo_http_server_requests_total[5m]))", "refId": "A", "instant": true }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Responses by status class",
      "datasource": { "uid": "PROM", "type": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (http.response.status_class) (rate(genesisgo_http_server_requests_total[5m]))", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active runs",
      "datasource": { "uid": "PROM", "type": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 8 },
      "targets": [
        { "expr": "genesisgo_runs_active", "refId": "A", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Run outcomes",
      "datasource": { "uid": "PROM", "type": "prometheus" },
      "gridPos": { "x": 6, "y": 8, "w": 18, "h": 8 },
      "targets": [
        { "expr": "sum by (run.status) (genesisgo_runs_completed_total)", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Delivery retries and invariant failures",
      "datasource": { "uid": "PROM", "type": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [
        { "expr": "sum(rate(genesisgo_delivery_retries_total[5m]))", "refId": "A", "legendFormat": "retries/sec" },
        { "expr": "sum(rate(genesisgo_invariants_evaluated_total{verdict=\"fail\"}[5m]))", "refId": "B", "legendFormat": "invariant failures/sec" }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}