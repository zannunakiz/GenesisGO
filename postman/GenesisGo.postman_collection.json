{
  "info": {
    "name": "GenesisGo API & Demo Acceptance (Step 45)",
    "_postman_id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Acceptance collection for the GenesisGo local stack at http://127.0.0.1:8080. Covers health, scenarios, run lifecycle, reports/exports, SSE guidance, auth/validation errors, and run isolation. Prerequisites: start the stack (`make compose-up`), bootstrap an API key (`go run ./cmd/bootstrap-key`), paste the `gg_` secret into the environment `api_key` variable. Newman is not installed on this host; validate by importing into Postman or run `npm install -g newman && newman run postman/GenesisGo.postman_collection.json -e postman/GenesisGo.postman_environment.json`."
  },
  "variable": [
    {"key": "base_url", "value": "http://127.0.0.1:8080"},
    {"key": "scenario_normal", "value": "normal_payment"},
    {"key": "scenario_dup", "value": "duplicate_delivery"},
    {"key": "scenario_retry", "value": "retry_after_timeout"},
    {"key": "scenario_ofo", "value": "out_of_order"},
    {"key": "scenario_crash", "value": "crash_after_commit_before_ack"},
    {"key": "scenario_restart", "value": "worker_restart"},
    {"key": "unknown_scenario", "value": "no_such_scenario"},
    {"key": "nil_uuid", "value": "00000000-0000-0000-0000-000000000000"},
    {"key": "idem_normal", "value": "gg-acceptance-normal-1"},
    {"key": "idem_dup", "value": "gg-acceptance-dup-1"}
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health/live",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health/live"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body is JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Live status ok\", () => { const b = pm.response.json(); pm.expect(b.status).to.eql(\"ok\"); pm.expect(b.uptime_seconds).to.be.a(\"number\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /health/ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 503\", () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));",
                  "pm.test(\"Body is JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Readiness shape\", () => { const b = pm.response.json(); pm.expect(b.status).to.be.oneOf([\"ok\", \"not_ready\"]); pm.expect(b.dependencies).to.be.an(\"object\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /healthz",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/healthz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body is JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Alias returns ok\", () => { const b = pm.response.json(); pm.expect(b.status).to.eql(\"ok\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Scenarios",
      "item": [
        {
          "name": "GET /api/v1/scenarios",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{api_key}}"}],
            "url": "{{base_url}}/api/v1/scenarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body is JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Scenario list non-empty\", () => { const b = pm.response.json(); pm.expect(b.scenarios).to.be.an(\"array\").that.is.not.empty; pm.expect(b.scenarios[0]).to.have.all.keys([\"key\", \"version\", \"name\"]); const keys = b.scenarios.map(s => s.key); pm.expect(keys).to.include(\"normal_payment\"); pm.expect(keys).to.include(\"duplicate_delivery\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Runs",
      "item": [
        {
          "name": "POST /api/v1/runs (normal_payment)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{api_key}}"},
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Idempotency-Key", "value": "{{idem_normal}}"}
            ],
            "body": {"mode": "raw", "raw": "{\"scenario_key\":\"{{scenario_normal}}\"}"},
            "url": "{{base_url}}/api/v1/runs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Body is JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Run created and id stored\", () => { const b = pm.response.json(); pm.expect(b.run.id).to.be.a(\"string\").that.is.not.empty; pm.expect(b.run.scenario_key).to.eql(\"normal_payment\"); pm.expect(b.run.status).to.be.oneOf([\"pending\", \"running\", \"completed\"]); pm.environment.set(\"run_id\", b.run.id); pm.environment.set(\"run_scenario_id\", b.run.scenario_id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/runs/{id}",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{api_key}}"}],
            "url": "{{base_url}}/api/v1/runs/{{run_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body is JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Run id matches\", () => { const b = pm.response.json(); pm.expect(b.run.id).to.eql(pm.environment.get(\"run_id\")); pm.expect(b.run.scenario_id).to.eql(pm.environment.get(\"run_scenario_id\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/runs (page)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{api_key}}"}],
            "url": "{{base_url}}/api/v1/runs?limit=5&offset=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body is JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Pagination shape\", () => { const b = pm.response.json(); pm.expect(b.runs).to.be.an(\"array\"); pm.expect(b.total).to.be.a(\"number\"); pm.expect(b.limit).to.eql(5); pm.expect(b.offset).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/runs/{id}/cancel",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{api_key}}"}],
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 409\", () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));",
                  "pm.test(\"Body is JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Cancellation outcome\", () => { if (pm.response.code === 200) { const b = pm.response.json(); pm.expect(b.run.status).to.eql(\"cancelled\"); } });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reports & Export",
      "item": [
        {
          "name": "GET /api/v1/runs/{id}/report",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{api_key}}"}],
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/report"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 404\", () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
                  "pm.test(\"Body is JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Report shape when ready\", () => { if (pm.response.code === 200) { const b = pm.response.json(); pm.expect(b.schema_version).to.eql(\"1.0.0\"); pm.expect(b.run.id).to.eql(pm.environment.get(\"run_id\")); pm.expect(b.invariant_results).to.be.an(\"array\"); pm.expect(b.event_attempts).to.be.an(\"array\"); } });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/runs/{id}/export (JSON)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{api_key}}"}],
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/export"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 404\", () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
                  "pm.test(\"JSON content type when present\", () => { if (pm.response.code === 200) { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); } });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/runs/{id}/export.csv",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{api_key}}"}],
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/export.csv"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 404\", () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
                  "pm.test(\"CSV content type when present\", () => { if (pm.response.code === 200) { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/csv\"); } });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Events (SSE)",
      "item": [
        {
          "name": "GET /api/v1/runs/{id}/events (SSE guidance)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{api_key}}"},
              {"key": "Last-Event-ID", "value": "{{last_event_id}}"},
              {"key": "Accept", "value": "text/event-stream"}
            ],
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"SSE endpoint reachable\", () => { pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]); if (pm.response.code === 200) { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/event-stream\"); pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-cache\"); } });",
                  "console.log(\"SSE stream held open by server; clients reconnect with Last-Event-ID. See OpenAPI GET /api/v1/runs/{id}/events.\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth & Validation (deliberate errors)",
      "item": [
        {
          "name": "GET /api/v1/scenarios without key -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/scenarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Error envelope\", () => { const b = pm.response.json(); pm.expect(b.code).to.eql(\"unauthorized\"); pm.expect(b.message).to.be.a(\"string\"); pm.expect(b.request_id).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/runs empty body -> 400",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{api_key}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{}"},
            "url": "{{base_url}}/api/v1/runs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error envelope\", () => { const b = pm.response.json(); pm.expect(b.code).to.be.oneOf([\"invalid_field\", \"invalid_json\"]); pm.expect(b.request_id).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/runs unknown scenario -> 404",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{api_key}}"},
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Idempotency-Key", "value": "gg-acceptance-unknown-1"}
            ],
            "body": {"mode": "raw", "raw": "{\"scenario_key\":\"{{unknown_scenario}}\"}"},
            "url": "{{base_url}}/api/v1/runs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error envelope\", () => { const b = pm.response.json(); pm.expect(b.code).to.eql(\"not_found\"); pm.expect(b.request_id).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/runs/{nil uuid} -> 404",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{api_key}}"}],
            "url": "{{base_url}}/api/v1/runs/{{nil_uuid}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error envelope\", () => { const b = pm.response.json(); pm.expect(b.code).to.eql(\"not_found\"); pm.expect(b.request_id).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Run Isolation",
      "item": [
        {
          "name": "POST /api/v1/runs (duplicate_delivery, second run)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{api_key}}"},
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Idempotency-Key", "value": "{{idem_dup}}"}
            ],
            "body": {"mode": "raw", "raw": "{\"scenario_key\":\"{{scenario_dup}}\"}"},
            "url": "{{base_url}}/api/v1/runs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Second run id stored\", () => { const b = pm.response.json(); pm.expect(b.run.id).to.be.a(\"string\").that.is.not.empty; pm.expect(b.run.id).to.not.eql(pm.environment.get(\"run_id\")); pm.environment.set(\"run_id_b\", b.run.id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/runs/{run_id} still run A",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{api_key}}"}],
            "url": "{{base_url}}/api/v1/runs/{{run_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Run isolation: id unchanged\", () => { const b = pm.response.json(); pm.expect(b.run.id).to.eql(pm.environment.get(\"run_id\")); pm.expect(b.run.id).to.not.eql(pm.environment.get(\"run_id_b\")); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
