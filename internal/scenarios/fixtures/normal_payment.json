    { "id": "ack-1", "type": "ack", "event_id": "evt-pay-000" }
  ],
  "parameters": { "max_events": 5, "max_retries": 3, "timeout_ms": 15000, "concurrency": 1 },
  "invariants": [
    { "key": "no_duplicate_payment", "type": "no_duplicate_effect", "effect_type": "payment", "aggregate": "order-000" },
    { "key": "idempotency_key_unique", "type": "idempotency_key_unique", "effect_type": "payment" }
  ],
  "seed": 0
