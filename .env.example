# Local development defaults. Replace only with local values; do not commit secrets.
APP_ENV=development
LISTEN_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://localhost:5432/genesisgo?sslmode=disable
NATS_URL=nats://127.0.0.1:4222
WORKER_CONCURRENCY=4
RUN_TIMEOUT=2m
MAX_EVENTS_PER_RUN=1000
MAX_BODY_BYTES=1048576
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# API-key authentication for control-plane routes. Keys are stored only as
# digests in API_KEYS_FILE. Generate a local key with:
#   go run ./cmd/bootstrap-key
# Copy the printed secret once into GENESISGO_API_KEY; never commit it.
API_KEYS_ENABLED=true
API_KEYS_FILE=.local/api-keys.json
BOOTSTRAP_KEY_ID=local-admin
BOOTSTRAP_SCOPES=admin
# DEMO_AUTH_DISABLED=true allows the local demo frontend to call read-only
# demo routes without a key. Keep false in production.
DEMO_AUTH_DISABLED=false

# Optional Arcjet protection; leave disabled for local development.
ARCJET_ENABLED=false
ARCJET_KEY=replace-with-your-Arcjet-key

# Optional local AI and telemetry integrations.
OLLAMA_URL=
OLLAMA_MODEL=
TELEMETRY_ENDPOINT=
